# ---------------------------------------------------------------------------
# Gambling Hub — backend environment
# Copy to `.env` and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# --- Database --------------------------------------------------------------
# Postgres runs in Docker on host port 5433 (doc 07). Start it with:
#   npm run db:up
DATABASE_URL="postgresql://gamblinghub:gamblinghub@localhost:5433/gamblinghub"

# --- Auth (doc 01) ---------------------------------------------------------
# Generate with: openssl rand -hex 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Domain shown inside the Sign-In-With-Solana message the user signs
SIWS_DOMAIN=localhost:5173
# How long a sign-in challenge stays valid, in seconds
AUTH_NONCE_TTL_SECONDS=300

# --- Solana / Treasury (doc 02) -------------------------------------------
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
# Commitment used to credit deposits. Doc 02 locks this to `confirmed`.
SOLANA_COMMITMENT=confirmed

# Treasury secret key, base58-encoded (what Phantom exports).
# Generate a fresh devnet one with: npm run treasury:new
TREASURY_SECRET_KEY=

# Set to false to boot the API without connecting to Solana
# (useful for frontend work — deposits/withdrawals return 503 instead).
ENABLE_DEPOSIT_LISTENER=true

# Minimum withdrawal, in SOL
MIN_WITHDRAWAL_SOL=0.01

# --- Referral anti-Sybil (doc 09) ------------------------------------------
# A referral commission is only PAID once the invited player has put real money
# at risk. Both gates must clear; setting either to 0 disables that half.
#
# The wagering gate is the one that bites: every pooled wager already pays the
# platform 5% of the pot, so requiring turnover before paying a 5% commission
# means the house collects rake before it pays out, and self-referral rings run
# at a loss. The deposit gate closes the hole wagering alone leaves — turnover
# manufactured from balance that never came from outside the system.
#
# These devnet defaults are deliberately small. RAISE THEM BEFORE REAL-MONEY
# MODE, where the payout is worth farming.
REFERRAL_MIN_DEPOSIT_SOL=0.05
REFERRAL_MIN_WAGERED_SOL=0.1
